# Godot 4
.godot/
/android/
*.translation
export_presets.cfg
export_credentials.cfg
.import/
# Local builds
/build/
*.tmp
# OS
.DS_Store
Thumbs.db
desktop.ini

# Chirp Studio export (transfer file, read by chirp_bridge.py import)
tools/chirp_studio/manifest.json

__pycache__/
*.pyc

# Godot's per-image import settings for the character, gear and VFX art: Godot
# writes them on every machine that opens the project, so git skips them here
# (Brian, 2026-11-17). Ones already committed stay tracked.
assets/units/**/*.import
assets/gear/**/*.import
assets/vfx/**/*.import
